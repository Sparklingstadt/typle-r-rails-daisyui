<%# typle-r src/app/(workspace)/records and src/components/Records (RecordHistory, RecordRow, ListSummary, FilterMenu, RecordsEmpty). %>
<% now = Time.current %>
<% filter = { pack: @pack&.id, list: @list&.id, device: @device }.compact %>
<% records_url = ->(changes = {}) { practice_records_path(filter.merge(changes).compact.presence) } %>
<% link = "underline underline-offset-3 hover:text-base-content" %>
<%= page_main(width: :medium) do %>
  <%= page_header(records_t("history.title"), records_rich("history.intro", { rankings: ->(chunks) { link_to(chunks, rankings_path, class: link) }, home: ->(chunks) { link_to(chunks, home_path, class: link) } })) do %><%= render "layouts/application/page_storage_badge" %><% end %>

  <% if @all.empty? %>
    <%= empty_state(class: "py-10 sm:py-14") do %>
      <%= empty_state_icon(:history) %>
      <div class="space-y-1.5">
        <h2 class="font-bold"><%= records_t("history.empty.title") %></h2>
        <p class="max-w-md text-sm text-balance text-base-content/60"><%= records_t("history.empty.description") %></p>
      </div>
      <%= link_button play_path do %><%= icon(:keyboard) %><%= records_t("history.empty.practice") %><% end %>
    <% end %>
  <% else %>
    <% filtered = filter.any? %>
    <% pack_options = @packs.filter_map { |pack|
         count = @lists.select { |list| list.pack_id == pack.id }.sum { |list| list.practice_records.size }
         [pack.id, pack.name, count] if count.positive? || pack == @pack
       } %>
    <% list_options = @lists.select { |list| !@pack || list.pack_id == @pack.id }
         .sort_by { |list| [@packs.index(list.pack) || 0, list.position.to_i, list.id] }
         .map { |list| [list.id, @pack ? records_level_name(list) : list.full_name, list.practice_records.size] } %>
    <div class="space-y-6">
      <div class="flex flex-wrap items-center gap-2">
        <%= render PracticeRecords::FilterMenuComponent.new(name: records_t("history.filter.pack"), all_label: records_t("history.filter.all_packs"), value: @pack&.id, options: pack_options,
              url: ->(value) { records_url.({ pack: value, list: (@list if value && @list&.pack_id == value)&.id }) }) %>
        <%= render PracticeRecords::FilterMenuComponent.new(name: records_t("history.filter.list"), all_label: records_t("history.filter.all_lists"), value: @list&.id, options: list_options,
              url: ->(value) { records_url.({ list: value }) }) %>
        <%= render PracticeRecords::FilterMenuComponent.new(name: records_t("history.filter.device"), all_label: records_t("history.filter.all_devices"), value: @device, options: records_device_choices(@device_options),
              url: ->(value) { records_url.({ device: value }) }) %>
        <% if filtered %>
          <%= link_button records_t("history.filter.clear"), practice_records_path, variant: :ghost, size: :lg, class: "text-base-content/60" %>
        <% end %>
        <p id="record-count" aria-live="polite" class="ml-auto text-sm text-base-content/60 tabular-nums">
          <%= filtered ? records_t("history.filter.filtered_count", matched: @records.size, count: @all.size) : records_t("history.filter.count", count: @all.size) %>
        </p>
      </div>

      <% if @list && @list.practice_records.any? %>
        <% last = @list.practice_records.map(&:practiced_at).max %>
        <section aria-labelledby="list-summary-heading" class="grid gap-4 rounded-xl border bg-base-100 p-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center sm:gap-6 sm:p-5">
          <div class="min-w-0">
            <h2 id="list-summary-heading" class="font-bold [overflow-wrap:anywhere]"><%= practice_name(@list) %></h2>
            <p class="text-[13px] text-base-content/60 tabular-nums">
              <%= records_t("history.summary.words", count: @list.words.size) %> · <%= records_t("history.summary.runs", count: @list.practice_records.size) %> · <%= records_t("history.summary.last", day: records_day(last, now)) %>
            </p>
          </div>
          <% bests = PracticeRecord::MODES.filter_map { |mode| [mode, @list.best(mode)] if @list.best(mode) } %>
          <% if bests.any? %>
            <div class="grid min-w-0 gap-2 sm:text-right">
              <% bests.each do |mode, best| %>
                <div data-best-mode="<%= mode || "normal" %>">
                  <p class="inline-flex items-center gap-1 text-xs text-base-content/60"><%= icon(:trophy, class: "size-3 text-warning") %><%= records_t("history.summary.best", mode: records_t("rankings.mode.#{mode || "normal"}")) %></p>
                  <p class="tabular-nums"><%= records_time(best.seconds, class: "text-lg font-bold") %><span class="ml-2 text-sm"><%= records_accuracy(best.accuracy) %></span>
                    <span class="ml-2 text-xs text-base-content/60"><%= records_day(best.practiced_at, now) %></span></p>
                </div>
              <% end %>
            </div>
          <% end %>
          <div class="flex flex-wrap gap-2">
            <%= link_button records_t("history.summary.rankings"), rankings_path(list: @list.id), variant: :outline, class: "grow sm:grow-0" %>
            <%= link_button play_path(list: @list.id), class: "grow sm:grow-0" do %><%= icon(:keyboard) %><%= records_t("history.summary.practice") %><% end %>
          </div>
        </section>
      <% end %>

      <% if @records.empty? %>
        <% unpractised = @list && @list.practice_records.empty? %>
        <%= empty_state(class: "py-10") do %>
          <div class="space-y-1.5">
            <h2 class="font-bold"><%= unpractised ? records_t("history.filtered_empty.list_title", name: @list.full_name) : records_t("history.filtered_empty.title") %></h2>
            <p class="text-sm text-base-content/60"><%= records_t(unpractised ? "history.filtered_empty.list_description" : "history.filtered_empty.description") %></p>
          </div>
          <div class="flex flex-wrap justify-center gap-2">
            <% if @list %>
              <%= link_button play_path(list: @list.id) do %><%= icon(:keyboard) %><%= records_t("history.filtered_empty.practice_list") %><% end %>
            <% end %>
            <%= link_button records_t("history.filter.clear"), practice_records_path, variant: :outline %>
          </div>
        <% end %>
      <% else %>
        <% shown = @records.first(@shown) %>
        <div class="space-y-6">
          <div aria-hidden="true" class="<%= cn("hidden px-5 text-xs text-base-content/60 sm:grid", RecordsDesignHelper::RECORDS_COLUMNS) %>">
            <span><%= records_t("history.columns.time") %></span><span><%= records_t(@list ? "history.columns.device_words" : "history.columns.list_device") %></span>
            <span class="text-right"><%= records_t("history.columns.duration") %></span><span class="text-right"><%= records_t("history.columns.accuracy") %></span>
            <span class="text-right"><%= records_t("history.columns.per_word") %></span><span class="text-right"><%= records_t("history.columns.mistakes") %></span><span></span>
          </div>
          <% shown.chunk_while { |a, b| a.practiced_at.to_date == b.practiced_at.to_date }.each do |day_records| %>
            <% heading = records_day_heading(day_records.first.practiced_at, now) %>
            <section aria-label="<%= heading %>" class="space-y-2">
              <div class="flex items-baseline justify-between gap-3 px-1">
                <h2 class="text-sm font-bold"><%= heading %></h2>
                <p class="text-xs text-base-content/60 tabular-nums"><%= records_t("history.day.summary", count: day_records.size, duration: records_duration(day_records.sum(&:seconds))) %></p>
              </div>
              <ul class="<%= UiHelper::CARD_LIST %>">
                <% day_records.each do |record| %>
                  <%= render PracticeRecords::RowComponent.new(record:, show_list: @list.nil?, in_pack: @pack.present?, best: @bests.include?(record)) %>
                <% end %>
              </ul>
            </section>
          <% end %>
          <% if @records.size > @shown %>
            <div class="flex justify-center">
              <%= link_button records_t("history.more", count: @records.size - @shown), records_url.({ shown: @shown + PracticeRecordsController::PAGE_SIZE }), variant: :outline %>
            </div>
          <% end %>
          <p class="text-xs text-base-content/60"><%= records_t("history.note") %></p>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
