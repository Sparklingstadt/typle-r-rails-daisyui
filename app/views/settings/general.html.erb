<% content_for :title, settings_t("general.title") %>
<%= page_main(width: :narrow) do %>
  <%= page_header settings_t("general.title"), settings_t("general.description"), plain: true %>
  <div class="space-y-6">
    <%= settings_section(icon: :languages, id: "language", title: settings_t("general.language.heading"), description: settings_t("general.language.description")) do %>
      <%= form_with url: locale_settings_path, method: :patch, data: { controller: "autosubmit" } do |f| %>
        <fieldset aria-labelledby="language-heading" aria-describedby="language-description" class="mt-4 grid gap-2 sm:grid-cols-2 sm:pl-14">
          <% locale_names.each do |code, name| %>
            <% checked = I18n.locale.to_s == code %>
            <label class="<%= cn("flex min-h-14 cursor-pointer items-center gap-3 rounded-lg border px-3 py-2.5 transition-colors has-[:focus-visible]:ring-3 has-[:focus-visible]:ring-primary/50",
                                 checked ? "border-primary bg-base-200" : "hover:bg-base-200/60") %>">
              <%= radio_button_tag :locale, code, checked, class: "sr-only", data: { action: "change->autosubmit#submit" } %>
              <span class="min-w-0 flex-1">
                <span lang="<%= code %>" class="block font-medium"><%= name %></span>
                <span class="block text-xs text-base-content/60"><%= settings_t("general.languages.#{code}") %></span>
              </span>
              <% if checked %>
                <span class="inline-flex shrink-0 items-center gap-1 text-xs font-medium text-primary"><%= icon(:check) %><%= settings_t("general.language.current") %></span>
              <% else %>
                <span aria-hidden="true" class="size-4 shrink-0 rounded-full border-2 border-base-content/24"></span>
              <% end %>
            </label>
          <% end %>
        </fieldset>
        <noscript><div class="mt-3 sm:pl-14"><%= f.submit settings_t("form.save"), class: button_classes(variant: :outline, size: :sm) %></div></noscript>
      <% end %>
      <p role="status" aria-live="polite" class="mt-3 text-[13px] text-base-content/60 sm:pl-14"><%= settings_t("general.language.note") %></p>
    <% end %>
    <% if signed_in? %><%= render "settings/account" %><% end %>
  </div>
<% end %>
