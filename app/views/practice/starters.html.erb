<% content_for :title, tt("nav.links.play") %>
<%# StarterPacks: /play for someone with no pack yet. Choosing a pack follows it and starts its first list at once. %>
<main class="mx-auto my-6 w-11/12 max-w-7xl pb-12 sm:my-8">
  <section aria-labelledby="starter-title" class="space-y-6">
    <div class="space-y-2">
      <h1 id="starter-title" class="text-2xl font-bold"><%= t("design.practice.starter.title") %></h1>
      <p class="text-base text-base-content/60"><%= t("design.practice.starter.description") %></p>
    </div>
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% @starters.each_with_index do |pack, index| %>
        <% first = pack.lists.first %>
        <% name_id = "starter-#{pack.catalog_id}" %>
        <li data-catalog-id="<%= pack.catalog_id %>">
          <%= card(class: "h-full gap-3 px-5 py-5") do %>
            <p class="text-[13px] text-base-content/60"><%= pack_stats(pack.lists.size, pack.word_count) %></p>
            <h2 id="<%= name_id %>" class="text-lg font-bold"><%= pack.name %></h2>
            <p class="text-[13px] text-base-content/60"><%= t("design.practice.starter.first", list: first&.name.to_s) %></p>
            <ul class="space-y-1 font-mono text-[15px]">
              <% pack.first_words.each do |word| %><li><%= word[:display] %></li><% end %>
            </ul>
            <%= form_button t("design.practice.starter.start"), follow_catalog_path(pack.catalog_id, practice: 1), variant: index.zero? ? :primary : :outline,
                  icon: "keyboard", class: "w-full", form_class: "mt-auto", "aria-describedby": name_id %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="text-base"><%= t("design.practice.starter.more_html",
          catalog_open: "<a href=\"#{h(catalog_index_path)}\" class=\"underline\">".html_safe,
          create_open: "<a href=\"#{h(new_pack_path)}\" class=\"underline\">".html_safe, close: "</a>".html_safe) %></p>
  </section>
</main>
