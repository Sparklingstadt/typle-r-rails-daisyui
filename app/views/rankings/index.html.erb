<%# typle-r src/app/(workspace)/rankings and src/components/Rankings (RankingsView, RankingList, RankingDetail, TopRecords, OrderToggle, NoRankings). %>
<% view = { device: @device&.value, order: (@order if @order == "speed"), mode: @mode, sort: (@sort unless @sort == "recent"), q: params[:q].to_s.strip.presence } %>
<% rankings_url = ->(changes = {}) { rankings_path(view.merge(list: @requested&.id).merge(changes).compact.presence) } %>
<%= page_main(width: :wide) do %>
  <%= page_header(records_t("rankings.title"), records_t("rankings.intro")) do %><%= render "layouts/application/page_storage_badge" %><% end %>

  <% if !@practised %>
    <%= empty_state(class: "py-12 sm:py-16") do %>
      <%= empty_state_icon(:trophy, class: "bg-warning/15 text-warning") %>
      <div class="space-y-1.5">
        <h2 class="font-bold"><%= records_t("rankings.empty.title") %></h2>
        <p class="max-w-md text-sm text-balance text-base-content/60"><%= records_t("rankings.empty.description") %></p>
      </div>
      <div class="flex flex-wrap justify-center gap-2">
        <%= link_button play_path, size: :sm do %><%= icon(:keyboard) %><%= records_t("rankings.empty.practice") %><% end %>
        <%= link_button new_pack_path, size: :sm, variant: :outline do %><%= icon(:plus) %><%= records_t("rankings.empty.create") %><% end %>
      </div>
    <% end %>
  <% else %>
    <% opened = @requested.present? %>
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <%= render PracticeRecords::FilterMenuComponent.new(name: records_t("rankings.filter.device"), all_label: records_t("rankings.filter.all_devices"), value: @device&.value,
              options: records_device_choices(@device_options, mark_deleted: true), url: ->(value) { rankings_url.({ device: value }) }) %>
        <%= records_pill(label: records_t("rankings.mode.label"), items: PracticeRecord::MODES.map { |mode|
              [records_t("rankings.mode.#{mode || "normal"}"), rankings_url.({ mode: }), mode == @mode] }) %>
        <%= records_pill(label: records_t("rankings.order.label"), items: ListRanking::ORDERS.map { |order|
              [records_rich("rankings.order.#{order}", { wide: ->(chunks) { tag.span(chunks, class: "hidden sm:inline") } }), rankings_url.({ order: (order if order == "speed") }), order == @order] }) %>
        <p class="hidden items-center gap-1.5 text-xs text-base-content/60 sm:flex">
          <%= icon(:info, class: "size-3.5 shrink-0") %><%= records_t("rankings.order_notes.#{@order}") %>
        </p>
      </div>

      <div class="xl:grid xl:grid-cols-[320px_minmax(0,1fr)] xl:items-start xl:gap-6">
        <section aria-label="<%= records_t("rankings.lists") %>" data-ranking-list class="<%= cn(UiHelper::PANEL, "xl:sticky xl:top-6", opened && "hidden xl:block") %>">
          <%= render "rankings/list", packs: @packs, selected: @detail&.list, rankings_url: %>
        </section>
        <% if @detail %>
          <section aria-labelledby="ranking-title" class="<%= cn(UiHelper::PANEL, "min-w-0", !opened && "hidden xl:block") %>">
            <%= render Rankings::DetailComponent.new(ranking: @detail, mode: @mode, device: @device, order: @order, show_all: @show_all, include_others: @include_others, rankings_url:) %>
          </section>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
