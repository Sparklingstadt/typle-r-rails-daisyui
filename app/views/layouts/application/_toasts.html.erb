<%# typle-r's SaveNotification: what a save did, at the bottom, closing by itself after five seconds unless pointed at. %>
<div class="fixed bottom-4 left-1/2 z-50 flex max-h-[calc(100dvh-2rem)] w-[90%] -translate-x-1/2 flex-col gap-3 overflow-y-auto p-1 sm:w-[70%]" aria-label="<%= tt("common.notifications") %>">
  <% if notice.present? %>
    <div role="status" aria-live="polite" aria-atomic="true" data-controller="toast"
         data-action="mouseenter->toast#hold mouseleave->toast#release focusin->toast#hold focusout->toast#release"
         class="<%= alert_classes(:success, "flex items-center gap-3 px-4 py-4 shadow-lg transition duration-300 motion-reduce:transition-none translate-y-4 opacity-0") %>">
      <span class="flex shrink-0 items-center"><%= icon(:check, class: "size-5") %></span>
      <span class="min-w-0 flex-1 break-words"><%= notice %></span>
      <button type="button" class="<%= button_classes(variant: :ghost, size: "icon-sm", class: "shrink-0 text-success-content hover:bg-success-content/15 hover:text-success-content focus-visible:ring-success-content/70") %>"
              aria-label="<%= tt("common.closeNotification") %>" data-action="toast#close"><%= icon(:x) %></button>
    </div>
  <% end %>
</div>
