<%
  # typle-r's nav.links names (its keys where this app's differ).
  nav_keys = { packs: :edit, new_pack: :create }
  groups = [
    [nil, [[:home, home_path, :house]]],
    [:practice, [[:play, play_path, :keyboard], [:records, practice_records_path, :history], [:rankings, rankings_path, :trophy]]],
    [:lists, [[:packs, packs_path, :list], [:words, words_path, "table-properties"], [:new_pack, new_pack_path, :plus]]],
    [:settings, [[:general, general_settings_path, :settings], [:input, input_settings_path, "text-cursor-input"], [:interests, interests_path, :sparkles], [:devices, devices_path, :monitor]]]
  ]
  help = [[:guide, guide_path, "book-open"], [:about, about_path, :info], [:github, "https://github.com/Sparklingstadt/typle-r", "external-link", true]]
  # The current item is the one whose path matches the page most closely (/packs/new is パックを作成, not 単語パック).
  all_paths = groups.flat_map { |_, links| links.map { |link| link[1] } } + help.map { |link| link[1] }
  # typle-r edits a list inside 単語パック (/edit?list=), while a pack's own editor and a new list of a pack (/packs/edit,
  # /create?pack=) are under no item.
  path = case request.path
    when %r{\A/word_lists/\d+/edit\z} then packs_path
    when %r{\A/packs/\d+/(edit|word_lists/new)\z} then nil
    else request.path
  end
  best_match = path && all_paths.select { |item| path == item || path.start_with?("#{item}/") }.max_by(&:length)
  current_section = ->(path) { path == best_match }
  item_class = ->(current) {
    cn("relative flex h-10 items-center gap-3 xl:h-8 rounded-md px-3 text-sm outline-none transition-colors focus-visible:ring-3 focus-visible:ring-primary/50 [&_svg]:size-4 [&_svg]:shrink-0",
       current ? "bg-primary/10 font-medium text-primary before:absolute before:inset-y-2.5 before:left-0 before:w-[3px] before:rounded-full before:bg-primary"
               : "text-base-content/80 hover:bg-base-200/60 hover:text-base-content [&_svg]:text-base-content/60 hover:[&_svg]:text-base-content")
  }
  nav_item = ->(name, path, icon_name, external = false) {
    current = !external && current_section.(path)
    tag.li(link_to(safe_join([icon(icon_name), tag.span(tt("nav.links.#{nav_keys.fetch(name, name)}"), class: "min-w-0 truncate")]), path,
      class: item_class.(current), "aria-current": (current ? "page" : nil)))
  }
%>
<div class="flex min-h-full flex-col gap-4">
  <nav aria-label="<%= t("layouts.application.main_navigation") %>">
    <% groups.each do |label, links| %>
      <div <% if label %>role="group" aria-label="<%= t("layouts.application.#{label}") %>"<% end %>>
        <% if label %><p class="px-3 pt-4 pb-1 text-xs font-medium text-base-content/60"><%= t("layouts.application.#{label}") %></p><% end %>
        <ul class="grid gap-0.5"><% links.each do |link| %><%= nav_item.(*link) %><% end %></ul>
      </div>
    <% end %>
  </nav>
  <nav aria-label="<%= t("layouts.application.help") %>" class="mt-auto border-t pt-1">
    <p class="px-3 pt-4 pb-1 text-xs font-medium text-base-content/60"><%= t("layouts.application.help") %></p>
    <ul class="grid gap-0.5"><% help.each do |link| %><%= nav_item.(*link) %><% end %></ul>
  </nav>
  <p class="px-3 pb-1 text-xs text-base-content/60 tabular-nums">v<%= Typle::VERSION %></p>
</div>
