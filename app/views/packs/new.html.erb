<% content_for :title, t("design.lists.pack_editor.create_title") %>
<%= page_main(width: :medium, class: "pb-0") do %>
  <% if @choices.empty? %>
    <%# typle-r's Notice: a pack is made of the user's own lists, and there are none yet. %>
    <div role="alert" class="<%= alert_classes %>">
      <%= icon("circle-alert") %>
      <div data-slot="alert-description" class="flex flex-wrap items-center gap-x-3 text-sm text-balance text-base-content/60">
        <span><%= tt("wordLists.packEditor.noLists") %></span>
        <%= link_to tt("wordLists.packEditor.createList"), create_list_path, class: "underline underline-offset-4" %>
      </div>
    </div>
  <% else %>
    <%= render "form", pack: @pack, title: t("design.lists.pack_editor.create_title"), description: tt("wordLists.packEditor.createDescription") %>
  <% end %>
<% end %>
