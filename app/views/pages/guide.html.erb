<%# typle-r's 使い方 (src/app/guide/page.tsx): the table of contents, sticky beside the sections on wide screens. %>
<% content_for :title, guide_t("title") %>
<%= page_main(width: :medium) do %>
  <header class="mb-8 space-y-1">
    <h1 class="text-2xl font-bold"><%= guide_t("title") %></h1>
    <p class="text-sm text-base-content/60"><%= guide_t("intro") %></p>
  </header>
  <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_11rem] xl:items-start xl:gap-10">
    <nav aria-labelledby="guide-contents" class="mb-10 rounded-xl border bg-base-100 p-4 xl:sticky xl:top-20 xl:order-2 xl:mb-0 xl:border-0 xl:bg-transparent xl:p-0">
      <h2 id="guide-contents" class="mb-2 text-xs font-bold text-base-content/60"><%= guide_t("contentsLabel") %></h2>
      <ol class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 xl:grid-cols-1 xl:gap-0 xl:border-l">
        <% %w[practice lists records devices storage shortcuts].each do |id| %>
          <li><a href="#<%= id %>" class="-ml-px flex min-h-9 items-center rounded-md px-2 text-base-content/60 outline-none hover:bg-base-200 hover:text-base-content focus-visible:ring-3 focus-visible:ring-primary/50 xl:rounded-none xl:border-l xl:border-transparent xl:px-3 xl:hover:border-base-content xl:hover:bg-transparent"><%= guide_t("contents.#{id}") %></a></li>
        <% end %>
      </ol>
    </nav>

    <div class="min-w-0 space-y-10 text-[15px] leading-[1.75] xl:order-1">
      <%= render "pages/guide/start" %>

      <%= render "pages/guide/practice" %>

      <%= render "pages/guide/lists" %>

      <%= render "pages/guide/records" %>

      <%= render "pages/guide/devices" %>

      <%= render "pages/guide/storage" %>

      <%= render "pages/guide/shortcuts" %>

      <div class="<%= cn(UiHelper::PANEL, "flex flex-col items-start gap-3 p-5 sm:flex-row sm:items-center sm:justify-between") %>">
        <p class="font-bold"><%= guide_t("cta.text") %></p>
        <%= link_button play_path do %><%= icon(:keyboard) %><%= guide_t("cta.action") %><% end %>
      </div>
    </div>
  </div>
<% end %>
