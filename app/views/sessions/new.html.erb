<%# typle-r's sign-in (signin-form.tsx): Sparklingstadt ID and GitHub, the only logins. A login that could not start, or
    that came back failed (?error=), is one message. %>
<% content_for :bare_title, tt("account.signIn") %>
<%= page_main(width: :narrow) do %>
  <header class="mb-6 space-y-1">
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  </header>
  <div class="max-w-sm space-y-4">
    <%# Sparklingstadt ID, the login shared by the Sparklingstadt services, comes first. %>
    <% if SidLogin.enabled? %>
      <%= form_button tt("account.signInWithSid"), "/auth/sid", method: :post, size: :lg, icon: "log-in", class: "w-full",
            form_class: "block", params: { origin: return_to }, data: { turbo: false } %>
    <% end %>
    <% if GithubLogin.enabled? %>
      <%= form_button tt("account.signInWithGitHub"), "/auth/github", method: :post, size: :lg, icon: "log-in", class: "w-full",
            variant: SidLogin.enabled? ? :outline : :default, form_class: "block", params: { origin: return_to }, data: { turbo: false } %>
    <% end %>
    <% if !SidLogin.enabled? && !GithubLogin.enabled? %>
      <p class="text-sm text-base-content/60"><%= tt("errors.authUnavailable") %></p>
    <% end %>
    <% if @local_login %>
      <%= form_button t(".local_login"), local_session_path, method: :post, size: :lg, variant: :outline, class: "w-full",
            form_class: "block", params: { returnTo: return_to } %>
    <% end %>
    <% if params[:error].present? %><%= form_message(tt("account.signInFailed"), kind: :error) %><% end %>
  </div>
<% end %>
