<%# typle-r's ErrorAlert: the reasons a form was not saved. %>
<% if record.errors.any? %>
  <% messages = record.errors.full_messages %>
  <div role="alert" class="<%= alert_classes(:error, cn("border-error/40 bg-error/5", local_assigns[:class])) %>">
    <%= icon("circle-alert") %>
    <div class="text-sm text-balance text-error/90 md:text-pretty">
      <% if messages.one? %>
        <%= messages.first %>
      <% else %>
        <ul class="list-disc space-y-0.5 pl-4"><% messages.each do |message| %><li><%= message %></li><% end %></ul>
      <% end %>
    </div>
  </div>
<% end %>
