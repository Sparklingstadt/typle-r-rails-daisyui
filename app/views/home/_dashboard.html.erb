<%# typle-r's src/components/Dashboard/Dashboard.tsx and the sections it holds (app/components/home). %>
<% now = Time.current %>
<div class="flex flex-col gap-9 lg:gap-12">
  <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
    <div class="space-y-2">
      <h1 class="text-2xl lg:text-3xl"><%= home_t("dashboard.title") %></h1>
      <p class="text-sm text-base-content/60"><%= home_t(current_user.guest? ? "dashboard.source_guest" : "dashboard.source_account") %></p>
    </div>
    <nav aria-label="<%= home_t("dashboard.start") %>" class="flex flex-wrap gap-3">
      <%# With a list to go on with, its card holds the practice button. %>
      <% unless dashboard.continue_list %><%= link_button home_t("dashboard.practice"), play_path, icon: "keyboard" %><% end %>
      <%= link_button home_t("dashboard.create"), create_list_path, variant: :outline, icon: "plus" %>
    </nav>
  </div>

  <%= render Home::ContinueComponent.new(dashboard:, now:) %>

  <%= render Home::SectionComponent.new(id: "week-heading", title: home_t("dashboard.week.title"),
        description: home_t("dashboard.week.description", start: home_date_with_weekday(dashboard.week_start, now), end: home_date_with_weekday(dashboard.week_start + 6.days, now))) do %>
    <%= render Home::WeekComponent.new(dashboard:) %>
  <% end %>

  <%= render Home::SectionComponent.new(id: "next-heading", title: home_t("dashboard.next.title"),
        description: home_t("dashboard.next.description", days: Dashboard::STALE_DAYS, count: Dashboard::STALE_DAYS, accuracy: Dashboard::LOW_ACCURACY)) do %>
    <%= render Home::NextListsComponent.new(dashboard:, now:) %>
  <% end %>

  <%= render Home::SectionComponent.new(id: "weak-heading", title: home_t("dashboard.weak.title"), description: home_t("dashboard.weak.description", runs: Dashboard::WEAK_RUNS)) do %>
    <%= render Home::WeakListsComponent.new(dashboard:) %>
  <% end %>

  <%= render Home::SectionComponent.new(id: "trends-heading", title: home_t("dashboard.trends.title"), description: home_t("dashboard.trends.description")) do %>
    <div class="grid items-start gap-4 xl:grid-cols-2">
      <% dashboard.list_trends.each do |trend| %>
        <%= render Home::TrendComponent.new(trend:, now:) %>
      <% end %>
    </div>
  <% end %>
</div>
