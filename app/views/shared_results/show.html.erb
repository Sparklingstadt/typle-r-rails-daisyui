<%# typle-r's app/result/page.tsx. The social card image of /result/image is not drawn here; the page sets the text of
    the card only. %>
<% content_for :noindex, true %>
<% if @result.nil? %>
  <% content_for :title, tt("sharedResult.invalidTitle") %>
  <main class="mx-auto w-full max-w-3xl space-y-4 px-4 pt-10 pb-16 sm:px-6">
    <h1 class="text-2xl font-bold"><%= tt("sharedResult.invalidTitle") %></h1>
    <p class="text-sm text-base-content/60"><%= tt("sharedResult.invalid") %></p>
    <%= link_button tt("sharedResult.about"), root_path %>
  </main>
<% else %>
  <% r = @result %>
  <% title = tt("sharedResult.title", name: r.name) %>
  <% description = tt("sharedResult.description", time: format("%.2f", r.time), accuracy: r.accuracy) %>
  <% content_for :title, title %>
  <% content_for :head do %>
    <meta name="description" content="<%= description %>">
    <meta property="og:title" content="<%= title %> | Typle"><meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="website"><meta property="og:site_name" content="Typle">
    <meta name="twitter:card" content="summary"><meta name="twitter:title" content="<%= title %> | Typle"><meta name="twitter:description" content="<%= description %>">
  <% end %>
  <% writing = r.mode == "writing" %>
  <% tiles = [[tt("practice.result.time"), format("%.2f", r.time), tt("practice.result.seconds")],
              [tt("practice.result.accuracy"), r.accuracy.to_s, "%"],
              [tt("practice.result.speed"), r.speed.nil? ? "—" : r.speed.to_s, tt(writing ? "practice.result.wordSpeedUnit" : "practice.result.speedUnit")],
              [tt("practice.result.words"), r.words.to_s, tt("practice.result.wordUnit", count: r.words)]] %>
  <% mode = { "writing" => tt("practice.modeWriting"), "recall" => tt("practice.recall.resultHeading") }[r.mode] %>
  <main class="mx-auto w-full max-w-3xl space-y-6 px-4 pt-10 pb-16 sm:px-6">
    <header class="space-y-3">
      <% if mode %><span class="inline-flex h-7 items-center rounded-full bg-primary/10 px-2.5 text-[13px] font-bold text-primary"><%= mode %></span><% end %>
      <h1 class="text-2xl font-bold [overflow-wrap:anywhere] sm:text-3xl"><%= tt("sharedResult.heading", name: r.name) %></h1>
    </header>
    <dl class="grid grid-cols-2 gap-2 sm:gap-3 md:grid-cols-4">
      <% tiles.each do |label, value, unit| %>
        <div class="grid min-w-0 content-start gap-0.5 rounded-xl border px-3 py-3 sm:px-4 sm:py-3.5">
          <dt class="text-xs text-base-content/60"><%= label %></dt>
          <dd class="text-2xl font-medium tabular-nums sm:text-[28px]"><%= value %><span class="ml-0.5 text-sm font-normal text-base-content/60"><%= unit %></span></dd>
        </div>
      <% end %>
    </dl>
    <p class="max-w-2xl text-sm text-base-content/60"><%= tt("sharedResult.lead") %></p>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_button play_path, size: :lg do %><%= icon(:keyboard) %><%= tt("sharedResult.play") %><% end %>
      <%= link_to tt("sharedResult.about"), root_path, class: "text-sm underline underline-offset-3 hover:text-base-content/60" %>
    </div>
  </main>
<% end %>
