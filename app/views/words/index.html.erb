<%# typle-r's 単語一覧 (Words/WordsView, WordTable, NoWords). %>
<%= page_main(width: :wide) do %>
  <%= page_header(tt("wordLists.words.title"), tt("wordLists.words.description")) do %>
    <%= render "layouts/application/page_storage_badge" %>
  <% end %>

  <% if @list.nil? %>
    <%= empty_state(class: "py-10 sm:py-14") do %>
      <%= empty_state_icon("list-plus") %>
      <div class="space-y-1.5">
        <h2 class="font-bold"><%= tt("wordLists.empty.title") %></h2>
        <p class="max-w-md text-sm text-balance text-base-content/60"><%= tt("wordLists.empty.description") %></p>
      </div>
      <%= link_button new_pack_path do %><%= icon(:plus) %><%= tt("wordLists.manager.create") %><% end %>
    <% end %>
  <% else %>
    <div class="space-y-4">
      <% if @requested && @list.id.to_s != @requested %>
        <div role="alert" class="<%= alert_classes %>"><%= icon("circle-alert") %><div data-slot="alert-description" class="text-sm text-balance text-base-content/60"><%= tt("wordLists.page.notFound") %></div></div>
      <% end %>
      <div class="grid items-start gap-6 lg:grid-cols-[20rem_minmax(0,1fr)]">
        <%= render "practice/aside", lists: @lists, selected: @list, mode: nil, id: "words-aside",
              url: ->(list) { words_path(list: list.id) }, heading: tt("wordLists.words.lists"), label: tt("wordLists.words.lists"), create: false,
              search_label: tt("wordLists.words.filter"), search_placeholder: tt("wordLists.words.filter"), no_match: tt("wordLists.words.noMatch"),
              aside_class: "hidden lg:sticky lg:top-20 lg:flex lg:max-h-[calc(100dvh-9rem)] lg:flex-col", card_class: "min-h-0 gap-1 p-3",
              scroll_class: "max-h-[36rem] min-h-0 overflow-y-auto overscroll-contain" %>
        <%= card(class: "min-w-0 gap-0 py-0 text-base") do %>
          <div class="flex flex-wrap items-start gap-x-4 gap-y-3 border-b px-4 py-4 sm:px-6">
            <div class="grid min-w-0 flex-1 basis-60 gap-1">
              <h2 id="words-title" class="text-lg font-bold [overflow-wrap:anywhere]"><%= practice_name(@list) %></h2>
              <%= list_labels(@list.category, @list.tags) %>
              <p class="text-sm text-base-content/60 [overflow-wrap:anywhere]"><%= tt("wordLists.words.wordCount", count: @list.words.size) %></p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <%# Under lg, where the side panel is not shown, the lists are chosen in typle-r's picker dialog. %>
              <div class="contents" data-controller="list-picker">
                <button type="button" aria-haspopup="dialog" aria-label="<%= tt("wordLists.words.switchList", name: practice_name_text(@list)) %>" data-action="list-picker#open" data-list-picker-target="trigger"
                  class="<%= button_classes(variant: :outline, size: :lg, class: "lg:hidden") %>"><%= icon("chevrons-up-down") %><%= tt("wordLists.words.switch") %></button>
                <%= render "practice/aside", lists: @lists, selected: @list, mode: nil, id: "words-picker",
                      url: ->(list) { words_path(list: list.id) }, heading: tt("wordLists.words.candidates"),
                      search_label: tt("wordLists.words.filter"), search_placeholder: tt("wordLists.words.filter"), no_match: tt("wordLists.words.noMatch"),
                      scroll_class: "-mx-1 max-h-[min(28rem,calc(100dvh-18rem))] overflow-y-auto overscroll-contain px-1",
                      dialog: { title: tt("wordLists.words.pickerTitle"), description: tt("wordLists.words.pickerDescription") } %>
              </div>
              <%= link_button play_path(list: @list.id), size: :lg, "aria-label": tt("wordLists.words.practiceList", name: practice_name_text(@list)) do %><%= icon(:keyboard) %><%= tt("wordLists.words.practice") %><% end %>
              <% if @list.editable? %>
                <%= link_button edit_word_list_path(@list), variant: :outline, size: :lg, "aria-label": tt("wordLists.words.editList", name: practice_name_text(@list)) do %><%= icon(:pencil) %><%= tt("wordLists.words.edit") %><% end %>
              <% else %>
                <%= link_button packs_path(pack: @list.pack_id), variant: :outline, size: :lg, "aria-label": tt("wordLists.words.editList", name: practice_name_text(@list)) do %><%= icon(:pencil) %><%= tt("wordLists.words.edit") %><% end %>
              <% end %>
            </div>
          </div>
          <table aria-labelledby="words-title" class="<%= cn(UiHelper::TABLE, "table-fixed") %>">
            <thead class="<%= UiHelper::TABLE_HEADER %>">
              <tr class="<%= cn(UiHelper::TABLE_ROW, "hover:bg-transparent") %>">
                <th class="<%= cn(UiHelper::TABLE_HEAD, "w-12 pl-4 text-right sm:w-14 sm:pl-6") %>"><span aria-hidden="true">#</span><span class="sr-only"><%= tt("wordLists.words.number") %></span></th>
                <th class="<%= cn(UiHelper::TABLE_HEAD, "pr-4 sm:pr-6") %>"><%= tt("wordLists.editor.input") %></th>
              </tr>
            </thead>
            <tbody class="<%= UiHelper::TABLE_BODY %>">
              <% @list.words.each_with_index do |word, index| %>
                <tr class="<%= cn(UiHelper::TABLE_ROW, "align-top") %>">
                  <td class="<%= cn(UiHelper::TABLE_CELL, "py-2.5 pl-4 text-right align-top text-base-content/60 tabular-nums sm:pl-6") %>"><%= index + 1 %></td>
                  <td class="<%= cn(UiHelper::TABLE_CELL, "py-2.5 pr-4 align-top sm:pr-6 whitespace-pre-wrap [overflow-wrap:anywhere]") %>"><span class="font-mono font-medium"><%= word.input %></span><% if word.display != word.input %><p class="mt-1 text-sm"><%= word.display %></p><% end %><% if word.annotation.present? %><p class="mt-1 text-[13px] text-base-content/60"><%= word.annotation %></p><% end %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
