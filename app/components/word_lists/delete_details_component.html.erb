<div class="space-y-3"><dl class="grid gap-1 rounded-lg border bg-base-200/40 px-3.5 py-3 text-sm"><dt class="sr-only"><%= tt("wordLists.delete.list") %></dt><dd class="font-medium [overflow-wrap:anywhere]"><%= list.name %></dd><dt class="sr-only"><%= tt("wordLists.delete.contents") %></dt><dd class="text-[13px] text-base-content/60 tabular-nums"><%= contents %></dd></dl><div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-base-content/60"><span class="min-w-0 flex-1 basis-56"><%= tt("wordLists.delete.exportHint") %></span><%= link_to export_word_list_path(list), class: button_classes(variant: :outline, size: :sm, class: "text-base-content"), data: { turbo: false } do %><%= icon(:download) %><%= tt("wordLists.delete.export") %><% end %></div></div>
