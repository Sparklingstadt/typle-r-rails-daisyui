<li class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-3 gap-y-1.5 px-4 py-3.5 sm:grid-cols-[auto_minmax(0,1fr)_10rem_auto] sm:items-center sm:gap-x-4 sm:px-5">
  <%= icon_tile(:monitor, class: "hidden sm:grid") %>
  <div class="min-w-0 space-y-0.5">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <h3 class="font-medium [overflow-wrap:anywhere]"><%= name %></h3>
      <% if current? %>
        <%= ui_badge variant: :outline, class: "border-success/30 bg-success/10 text-success", title: settings_t("devices.inUseDetail") do %><%= icon(:check) %><%= settings_t("devices.inUse") %><% end %>
      <% end %>
    </div>
    <% if device.nil? %>
      <p class="text-sm text-base-content/60"><%= settings_t("devices.defaultDetail") %></p>
    <% elsif device.layout.present? %>
      <p class="text-sm text-base-content/60 [overflow-wrap:anywhere]"><%= device.layout %></p>
    <% end %>
  </div>
  <p class="col-start-1 row-start-2 flex items-center gap-1.5 text-xs text-base-content/60 tabular-nums sm:col-start-3 sm:row-start-1 sm:text-[13px]">
    <%= icon(:history, class: "size-3.5 shrink-0") %><%= usage ? settings_t("devices.usage", count: usage[:count], day: records_day(usage[:last])) : settings_t("devices.neverUsed") %>
  </p>
  <% if device %>
    <div class="col-start-2 row-span-2 row-start-1 -mr-2 flex items-center sm:col-start-4 sm:row-span-1 sm:mr-0">
      <%= tag.button type: "button", data: { visit_url: devices_path(edit: device.id) }, class: button_classes(variant: :ghost, size: "icon-lg", class: "size-10 text-base-content/60"),
            "aria-label": settings_t("devices.editLabel", name:), title: settings_t("devices.edit") do %><%= icon(:pencil) %><% end %>
      <%= button_to device_path(device), method: :delete, form_class: "contents", form: { data: delete_confirm },
            class: button_classes(variant: :ghost, size: "icon-lg", class: "size-10 text-base-content/60 hover:bg-error/10 hover:text-error"),
            "aria-label": settings_t("devices.deleteLabel", name:), title: settings_t("devices.delete") do %><%= icon("trash-2") %><% end %>
    </div>
  <% end %>
</li>
